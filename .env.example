# Copy to .env and edit. docker-compose.yml reads this file automatically.
# Every variable here is consumed through backend/src/bot/settings.py (the one place the
# bot reads the environment).

# --- API auth (plan 09 §2) -------------------------------------------------------------
# Set a token to require `Authorization: Bearer <token>` on every endpoint except
# /api/health. Leave empty for dev mode (no auth). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_TOKEN=

# --- Web / ports -----------------------------------------------------------------------
# Host port the dashboard (nginx) is published on. Open http://localhost:<BOT_WEB_PORT>.
BOT_WEB_PORT=8080

# --- Databases -------------------------------------------------------------------------
# Live runner DB (plan 07) and the shared alert log. In Docker these are set by compose to
# paths inside the mounted /app/data volume; override here only for a bare-metal run.
# BOT_DB_PATH=/app/data/live.db
# BOT_ALERTS_DB_PATH=/app/data/alerts.db

# --- Telegram alerts (plan 13) ---------------------------------------------------------
# Both required for delivery; set neither to fall back to log-only alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Live venue credentials (plan 07/08, only needed for the `live` profile) ------------
# DNSE_API_KEY=
# DNSE_API_SECRET=
